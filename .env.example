# Clé secrète Stripe (Dashboard Stripe > Développeurs > Clés API). Lue uniquement par le serveur.
# sk_test_... = mode test (pastille « Mode test »), sk_live_... = paiements réels. Ne jamais préfixer par VITE_.
STRIPE_SECRET_KEY=
# Prix du jeu en euros, fixé par le serveur.
PRIX=19.99
# Facultatif : clé de signature du cookie d'achat (sinon dérivée de la clé Stripe).
COOKIE_SECRET=
# Facultatif : adresse publique du site pour les retours Stripe (sinon déduite de la requête).
PUBLIC_URL=
# Facultatif : adresse e-mail transmise à MyMemory (moteur de traduction du site) pour relever son quota gratuit
# de 5 000 à 50 000 caractères par jour. Lue par le navigateur (donc préfixe VITE_, au moment du build).
VITE_TRADUCTION_EMAIL=
# Développement uniquement : 1 = ignorer le paywall (VITE_ côté navigateur, sans préfixe côté serveur).
VITE_ACCES_LIBRE=
ACCES_LIBRE=
# Dons : aucune variable supplémentaire, les dons réutilisent la clé Stripe ci-dessus (même méthode que GobaiWebService).
#   GET /api/dons/config, POST /api/dons/commande { montant }, /api/dons/capture { id }, /api/dons/annule { id }
