# Lien de paiement Stripe (Dashboard Stripe > Liens de paiement).
# Dans « Après le paiement », choisir « Ne pas afficher de page de confirmation » / rediriger vers :
#   https://VOTRE-DOMAINE/achat.html?achat=merci&session_id={CHECKOUT_SESSION_ID}
# Un lien de test (https://buy.stripe.com/test_...) affiche la pastille « Mode test ».
VITE_STRIPE_PAYMENT_LINK=
# Prix affiché sur le site, en euros (doit correspondre au prix du lien Stripe).
VITE_PRIX=9.99
# Développement uniquement : 1 = ignorer le paywall.
VITE_ACCES_LIBRE=
